{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run sync:startup",
    "dev": "next dev",
    "prebuild": "npm run sync:startup",
    "prestart": "npm run sync:startup",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync:startup": "npm run sync:all:startup",
    "sync:all": "npm run sync:pull && npm run sync:images",
    "sync:all:startup": "npm run sync:pull:startup && npm run sync:images:startup",
    "sync:pull:startup": "node scripts/airtable-sync.mjs pull --startup",
    "sync:images:startup": "node scripts/sync-airtable-images.ts --max-pixels=2000000 || true",
    "sync:pull": "node scripts/airtable-sync.mjs pull",
    "sync:images": "node scripts/sync-airtable-images.ts --max-pixels=2000000",
    "sync:push": "node scripts/airtable-sync.mjs push",
    "sync:status": "node scripts/airtable-sync.mjs status",
    "sync:stage": "git add data/airtable public/tool-images scripts/airtable-sync.mjs scripts/sync-airtable-images.ts package.json",
    "sync:all:stage": "npm run sync:all && npm run sync:stage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.46",
    "@ai-sdk/react": "^3.0.97",
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ai": "^6.0.95",
    "html5-qrcode": "^2.3.8",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "unpdf": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
